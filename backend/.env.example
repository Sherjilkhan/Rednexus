# ==========================================
# Raktasetu Backend Environment Variables
# ==========================================

# Server Port
PORT=3001

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-here
JWT_EXPIRY=12h

# Database Configuration (PostgreSQL)
# Option A: Connection URL (e.g. Local, Supabase, Neon, Render, AWS RDS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raktasetu

# Option B: Individual PG parameters (used if DATABASE_URL is not provided)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGDATABASE=raktasetu
# PGSSL=false

# Explicit Database Mode: 'postgres' | 'firestore' | 'memory' (Optional; auto-detected if left empty)
DB_MODE=postgres

# Auto-seed initial demo accounts/institutions on empty database
SEED_ON_START=true
